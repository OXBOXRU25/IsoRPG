  title: "\u041A\u043E\u0441\u0442\u0438 \u0434\u043B\u044F \u043A\u043B\u0438\u043D\u043A\u0430"
  level: 1
  zone: "\u041A\u043E\u043B\u0434\u0440\u0438\u0434\u0436-\u0412\u044D\u043B\u043B\u0438"
  offerText: "\u0425\u043E\u0447\u0435\u0448\u044C \u044D\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u0438\u043D\u0436\u0430\u043B?\n\n\u0422\u043E\u0433\u0434\u0430 \u0441\u0445\u043E\u0434\u0438
    \u043A \u0440\u0443\u0438\u043D\u0430\u043C \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0438
    \u043C\u043D\u0435 \u043F\u044F\u0442\u044C \u043A\u043E\u0441\u0442\u0435\u0439
    \u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432. \u041D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439
    \u0437\u0430\u0447\u0435\u043C. \u041F\u0440\u0438\u043D\u0435\u0441\u0451\u0448\u044C
    \u2014 \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C \u043A\u043B\u0438\u043D\u043E\u043A,
    \u043A\u0430\u043A\u043E\u0433\u043E \u0443 \u0442\u0435\u0431\u044F \u0435\u0449\u0451
    \u043D\u0435 \u0431\u044B\u043B\u043E."
  inProgressText: "\u041F\u044F\u0442\u044C \u043A\u043E\u0441\u0442\u0435\u0439.
    \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F, \u043A\u043E\u0433\u0434\u0430
    \u043D\u0430\u0431\u0435\u0440\u0451\u0448\u044C."
  completeText: "\u0412\u0441\u0435 \u043F\u044F\u0442\u044C. \u041D\u0435 \u0434\u0443\u043C\u0430\u043B,
    \u0447\u0442\u043E \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F.\n\n\u0414\u0435\u0440\u0436\u0438,
    \u0447\u0442\u043E \u043E\u0431\u0435\u0449\u0430\u043D\u043E. \u041E\u043D \u0442\u0432\u043E\u0439."
