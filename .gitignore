# ============================================================
#  Unity — служебные папки. Генерируются заново при открытии
#  проекта, весят гигабайты, в репозитории им не место.
#  Паттерны без ведущего слэша — работают на любом уровне
#  вложенности, поэтому папку Unity-проекта можно переименовать.
# ============================================================

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Кеш пакетного менеджера
[Pp]ackages/com.unity.*/

# Артефакты сборки и IDE
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/
*.code-workspace

# Отладочные символы и нативные сборки
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
.consulo/
sysinfo.txt

# Crashlytics / отчёты
crashlytics-build.properties

# Windows / macOS мусор
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# Наш скратч
scratch/

# Рабочие снимки экрана: воспроизводимы в любой момент, в истории не нужны.
# Подобранные референсы лежат отдельно, в Screen/ — те версионируем.
shots/

# ============================================================
#  Скачанные наборы моделей, лежащие РЯДОМ с проектом.
#  В Assets импортировано только то, что реально используется,
#  а исходный архив набора весит десятки мегабайт и никому,
#  кроме автора набора, не нужен.
# ============================================================

Dungeon Remastered Pack

# ============================================================
#  Готовые пакеты и сборка лаунчера.
#  Собираются из исходников одной командой, весят сотни
#  мегабайт и меняются при каждой сборке — в истории им
#  делать нечего. Исходники лаунчера и скрипты сборки,
#  наоборот, версионируются.
# ============================================================

Package/
Launcher/dist/

# Страница истории версий и уменьшенный логотип для неё:
# и то и другое пересобирается из CHANGELOG.md.
site/
tools/logo-web.png

# Аварийная копия сцены, которую Unity делает после падения редактора.
_Recovery/
_Recovery.meta


