  m_Name: Q_BoarHunt
  m_EditorClassIdentifier: Assembly-CSharp::IsoRPG.Quests.QuestDefinition
  title: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E
    \u043A\u0430\u0431\u0430\u043D\u043E\u0432"
  level: 1
  zone: "\u041A\u043E\u043B\u0434\u0440\u0438\u0434\u0436-\u0412\u044D\u043B\u043B\u0438"
  offerText: "\u0427\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
    \u043B\u0443\u0447\u0448\u0435 \u0434\u043D\u044F \u043E\u0445\u043E\u0442\u044B
    \u043D\u0430 \u043A\u0430\u0431\u0430\u043D\u0430, \u0430?\n\n\u0425\u043E\u0442\u044F
    \u0437\u0434\u0435\u0441\u044C, \u0432 \u041A\u043E\u043B\u0434\u0440\u0438\u0434\u0436-\u0412\u044D\u043B\u043B\u0438,
    \u043A\u0430\u0431\u0430\u043D\u043E\u0432 \u0441\u0442\u043E\u043B\u044C\u043A\u043E,
    \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u043E\u0447\u0442\u0438 \u043B\u0438\u0448\u0430\u0435\u0442
    \u043E\u0445\u043E\u0442\u0443 \u0432\u0441\u044F\u043A\u043E\u0433\u043E \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F.
    \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
    \u0438\u0445 \u0432 \u043E\u043A\u0440\u0443\u0433\u0435 \u0440\u0430\u0437\u0432\u0435\u043B\u043E\u0441\u044C
    \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E, \u0447\u0442\u043E \u043C\u043D\u0435
    \u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C-\u0442\u043E \u043E\u043F\u0430\u0441\u043D\u043E
    \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C.\n\n\u041A\u043E\u0440\u043E\u0447\u0435
    \u0433\u043E\u0432\u043E\u0440\u044F, \u0431\u0443\u0434\u0443 \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u0435\u043D,
    \u0435\u0441\u043B\u0438 \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u043C\u043D\u0435
    \u043F\u0440\u043E\u0440\u0435\u0434\u0438\u0442\u044C \u0441\u0442\u0430\u0434\u043E.
    \u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438 \u0445\u0432\u0430\u0442\u0438\u0442.
    \u041A\u043B\u044B\u043A\u0438 \u043F\u0440\u0438\u043D\u043E\u0441\u0438 \u2014
    \u043F\u043E \u043D\u0438\u043C \u0438 \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u0435\u043C."
  inProgressText: "\u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043A\u043B\u044B\u043A\u043E\u0432,
    \u043E\u0445\u043E\u0442\u043D\u0438\u043A. \u041A\u0430\u0431\u0430\u043D\u044B
    \u0441\u0430\u043C\u0438 \u0441\u0435\u0431\u044F \u043D\u0435 \u0443\u0431\u0430\u0432\u044F\u0442."
  completeText: "\u041F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u043E!
    \u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043C\u043E\u0433\u0443 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u043A \u0441\u0432\u043E\u0435\u0439... \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u043E\u0439...
    \u043E\u0445\u043E\u0442\u0435. \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0428\u0438\u043A\u043E."
